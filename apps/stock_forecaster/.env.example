# Backend (prefix STOCK_FORECASTER_)
STOCK_FORECASTER_CHECKPOINT=google/timesfm-3.0-pytorch
STOCK_FORECASTER_DEVICE=auto
STOCK_FORECASTER_CORS_ORIGINS=["http://localhost:5173"]
STOCK_FORECASTER_CACHE_TTL_SECONDS=300
STOCK_FORECASTER_MIN_CONTEXT_LENGTH=32
STOCK_FORECASTER_DEFAULT_CONTEXT_LENGTH=512
STOCK_FORECASTER_MAX_CONTEXT_LENGTH=16384
STOCK_FORECASTER_MAX_HORIZON=60
STOCK_FORECASTER_MODEL_ENABLED=true
STOCK_FORECASTER_MAX_CONCURRENT_INFERENCES=1
STOCK_FORECASTER_LOG_LEVEL=INFO

# Frontend (read by Vite at build/start time)
VITE_API_BASE_URL=http://localhost:8000
